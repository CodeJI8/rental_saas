generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  subscriptionPlan String   @default("free")
  createdAt        DateTime @default(now())
  users            User[]
   properties       Property[]
}

model User {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("manager")
  createdAt    DateTime     @default(now())
}



model Property {
  id          String       @id @default(uuid())
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id])
  name        String
  address     String
  totalUnits  Int
  createdAt   DateTime     @default(now())
}