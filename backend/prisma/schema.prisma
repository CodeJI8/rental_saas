generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  subscriptionPlan String   @default("free")
  createdAt        DateTime @default(now())

  users       User[]
  properties  Property[]
  rentalTenants RentalTenant[]
  reminders   Reminder[]
  emailLogs   EmailLog[]
}

model User {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("manager") // admin/manager/accountant
  createdAt    DateTime     @default(now())
}

model Property {
  id         String   @id @default(uuid())
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  name       String
  address    String?
  totalUnits Int      @default(0)
  createdAt  DateTime @default(now())

  units Unit[]
}

model Unit {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  unitNumber String
  rentAmount Decimal  @db.Decimal(12, 2)
  status     String   @default("vacant") // vacant/occupied/maintenance
  createdAt  DateTime @default(now())

  rentalTenants RentalTenant[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
}

model RentalTenant {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  name          String
  phone         String?
  email         String?
  contractStart DateTime
  contractEnd   DateTime
  createdAt     DateTime @default(now())

  payments  Payment[]
  reminders Reminder[]
}

model Payment {
  id             String    @id @default(uuid())
  rentalTenantId String
  rentalTenant   RentalTenant @relation(fields: [rentalTenantId], references: [id])
  amount         Decimal   @db.Decimal(12, 2)
  dueDate        DateTime
  paidDate       DateTime?
  status         String    @default("pending") // pending/paid/overdue/partial
  createdAt      DateTime  @default(now())

  reminders Reminder[]
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  description String
  status      String   @default("open") // open/in_progress/resolved/closed
  createdAt   DateTime @default(now())
}

model Reminder {
  id             String   @id @default(uuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  rentalTenantId String
  rentalTenant   RentalTenant @relation(fields: [rentalTenantId], references: [id])
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  reminderType   String   // rent_due_soon/payment_overdue/contract_expiring
  scheduledFor   DateTime
  status         String   @default("pending") // pending/sent/failed/cancelled
  createdAt      DateTime @default(now())

  emailLogs EmailLog[]
}

model EmailLog {
  id             String    @id @default(uuid())
  reminderId     String?
  reminder       Reminder? @relation(fields: [reminderId], references: [id])
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  toEmail        String
  subject        String
  body           String
  generatedByAi  Boolean   @default(true)
  sendStatus     String    @default("queued") // queued/sent/failed
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
}
